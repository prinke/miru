# Required
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional: for faster command iteration
GUILD_ID=

# MongoDB
MONGODB_URI=
# Optional: database name inside the cluster (defaults to "miru")
MONGODB_DB=

# AniList OAuth — create an app at https://anilist.co/settings/developer and set
# its Redirect URL to exactly: https://anilist.co/api/v2/oauth/pin
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
# Optional: only if the app uses a redirect other than the pin page above
ANILIST_REDIRECT_URI=

# Encrypts stored AniList tokens. Generate with: openssl rand -hex 32
# Changing this makes every existing link unreadable.
TOKEN_ENCRYPTION_KEY=

# Optional: trace.moe API key for scene search (/trace, "What anime is this?").
# Without one, searches share a quota of 100 per month per server IP.
TRACE_MOE_API_KEY=
